        "next_action": "atomic_restructure"
      }
    },
    {
      "id": "negative-post-authoritative-design-change",
      "class": "negative",
      "used_for_tuning": true,
      "requirements": ["P1", "P2", "P4"],
      "input": {
        "event": "post_authoritative_design_change",
        "authoritative_validation_count": 1
      },
      "expected": {
        "state": "replan_required",
        "reason_code": "post_authoritative_design_change",
        "next_action": "atomic_restructure"
      }
    },
    {
      "id": "median-plan119-independent-validation-authorization-repair",
      "class": "median",
      "used_for_tuning": true,
      "requirements": ["P1", "P4", "P5"],
      "input": {
        "event": "repair_classification",
        "affected_invariant_count": 1,
        "bounded_write_and_validation_scope": true,
        "source_scope_changed": false,
        "validation_authority_changed": false,
        "invariant_boundaries_changed": false,
        "source_acceptance_changed": false,
        "safety_boundary_changed": false,
        "external_authority_changed": false
      },
      "expected": {
        "state": "repair_required",
        "reason_code": "independent_repair_required",
        "next_action": "defer_source_and_create_bounded_repair_plan"
      }
    },
    {
      "id": "edge-repair-required-run-cannot-continue",
      "class": "edge",
      "used_for_tuning": true,
      "requirements": ["P1", "P5"],
      "input": {
        "operation": "continue_same_execution_run",
        "execution_state": "repair_required"
      },
      "expected": {
        "state": "repair_required",
        "reason_code": "independent_repair_required",
        "next_action": "reject_transition"
      }
    },
    {
      "id": "edge-checked-repair-resumes-source-with-fresh-run",
