{
  "schema_version": 1,
  "requirements": [
    {
      "id": "P1",
      "critical": true,
      "text": "A hard trigger stops the current execution run before another implementation, validation, apply, or finalize operation."
    },
    {
      "id": "P2",
      "critical": true,
      "text": "An atomic restructuring preserves every source acceptance item and records an integration plan before implementation resumes."
    },
    {
      "id": "P3",
      "critical": true,
      "text": "A requirement replacement remains pending until separate explicit user authorization and cannot be accepted as clarification or acceptance mapping."
    },
    {
      "id": "P4",
      "critical": true,
      "text": "Elapsed time is telemetry only; scope, specification, security, invariant, correction, review, and post-authoritative evidence determine restructuring."
    },
    {
      "id": "P5",
      "critical": true,
      "text": "One independently repairable defect has unchanged source-plan scope, validation authority, and invariant boundaries; stops the current execution run; preserves the source plan as deferred without rewriting acceptance; requires a separate bounded repair plan; and resumes only through a fresh execution run after that repair is checked."
    }
  ],
  "holdout_file": "plan-restructuring-holdout.json",
  "scenarios": [
    {
      "id": "median-multiple-independent-invariants",
      "class": "median",
      "used_for_tuning": true,
      "requirements": ["P1", "P2", "P4"],
      "input": {
        "event": "parent_review",
        "independent_invariant_count": 2
      },
      "expected": {
        "state": "replan_required",
        "reason_code": "multiple_independent_invariants",
        "next_action": "atomic_restructure"
      }
    },
    {
      "id": "edge-delegated-correction-budget-exhausted",
      "class": "edge",
      "used_for_tuning": true,
      "requirements": ["P1", "P2", "P4"],
      "input": {
        "initial_generation_count": 1,
        "rejected_correction_count": 2
      },
      "expected": {
        "state": "replan_required",
        "reason_code": "candidate_correction_budget_exhausted",
        "next_action": "atomic_restructure"
      }
    },
    {
      "id": "edge-parent-direct-review-budget-exhausted",
      "class": "edge",
      "used_for_tuning": true,
      "requirements": ["P1", "P2", "P4"],
      "input": {
        "independently_reviewed_parent_remediation_count": 2,
        "remaining_finding_severity": "Medium"
      },
      "expected": {
        "state": "replan_required",
        "reason_code": "parent_remediation_budget_exhausted",
        "next_action": "atomic_restructure"
      }
    },
    {
      "id": "negative-scope-drift",
      "class": "negative",
      "used_for_tuning": true,
      "requirements": ["P1", "P2", "P4"],
      "input": {
