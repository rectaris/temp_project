        "source_scope_changed": false,
        "validation_authority_changed": false,
        "invariant_boundaries_changed": false,
        "requirements_changed": false,
        "safety_boundary_changed": false,
        "external_authority_changed": false,
        "execution_run": "fresh"
      },
      "expected": {
        "state": "in_progress",
        "reason_code": "repair_prerequisite_satisfied",
        "next_action": "resume_source_with_fresh_execution"
      }
    },
    {
