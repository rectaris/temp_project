[% set mcp_state = "documented" if mcp_policy_mode == "document_optional" else "disabled" %]
[% set linear_state = "documented" if linear_sync_mode == "document_optional" else "disabled" %]
[% set graph_state = "documented" if graph_memory_mode == "document_optional" else "disabled" %]
[% if external_access_profile == "task_scoped_default_allow" %]
version: 2

# task_scoped_default_allow means that a runtime-configured provider may perform the exact read or ordinary write required by the current user request without a per-operation allowlist.
access_profile: task_scoped_default_allow
# runtime_configured means that the active execution environment has configured and authenticated the requested provider; it does not authorize an operation by itself.
provider_requirement: runtime_configured
# current_user_request means the active user request whose requested outcome requires the exact provider, operation, target, and effect.
task_scope_rule: current_user_request
# ordinary means the classification for an external provider call to which no denied effect applies and that either changes no remote state for a read or has no confirmation-required effect for a write.
# confirmation_required_effects means the external write effects that require exact current-user confirmation for the same target and effect in addition to current-task relevance.
confirmation_required_effects:
  # remote_delete means an external write that deletes durable remote data or resources.
  - remote_delete
  # public_communication means an external write that publishes or sends content to people outside the acting user session.
  - public_communication
  # financial_commitment means an external write that purchases, pays, subscribes, or otherwise creates a financial commitment.
  - financial_commitment
  # production_change means an external write that deploys to or mutates a production environment.
  - production_change
  # access_control_change means an external write that grants, revokes, or changes permissions, roles, credentials, or access policy.
  - access_control_change
# denied_effects means external effects that the policy rejects before a provider call and that current-task relevance or confirmation cannot override.
denied_effects:
  # credential_material_transfer means sending credential material, tokens, private keys, or secret values to an external provider as task data.
  - credential_material_transfer
  # secret_persistence means persisting credential material, tokens, private keys, or secret values in repository or external durable records.
  - secret_persistence
  # write_credentials_to_untrusted_code means making credentials that can write external state available to untrusted code or an untrusted execution environment.
  - write_credentials_to_untrusted_code
# unclassified_write_effect means the authorization rule applied when the caller cannot classify the external write effect before the provider call.
# require_confirmation means that the current user must confirm the same target and effect as the proposed provider write.
unclassified_write_effect: require_confirmation
unavailable_fallback: "Use local repository files, plans, validation output, and Git history."

external_services:
  mcp:
    unavailable_fallback: "Use local repository files, plans, and validation only."
  linear_sync:
    unavailable_fallback: "Keep plan lifecycle local and record sync deferral only when it affects scope or completion."
  graph_memory:
    unavailable_fallback: "Use repository files, checked plans, validation output, and Git history as the source of truth."
  browser_run:
    unavailable_fallback: "Use ordinary HTTP retrieval when sufficient; otherwise report that no configured browser backend is available."
[% else %]
# restricted means that schema version 1 requires service states, connection metadata, per-operation allowlists, and write-authorization rules.
version: 1

states:
  disabled: Policy exists, but service reads and writes are not authorized.
  documented: Setup guidance exists, but service reads and writes are not authorized.
  configured_read_only: Connection, authentication, credential reference, and allowed reads pass the common external-service gate.
  configured_write_capable: Read requirements pass, allowed writes are non-empty, and the write-authorization check passes.

external_services:
  mcp:
    state: [[ mcp_state ]]
    connection: ""
    authentication: none
    credential_reference: ""
    allowed_reads: []
    allowed_writes: []
    write_authorization_rule: ""
    dry_run_or_local_validation: ""
    unavailable_fallback: "Use local repository files, plans, and validation only."
  linear_sync:
    state: [[ linear_state ]]
    connection: ""
    authentication: none
    credential_reference: ""
    allowed_reads: []
    allowed_writes: []
    write_authorization_rule: ""
    dry_run_or_local_validation: ""
    unavailable_fallback: "Keep plan lifecycle local and record sync deferral only when it affects scope or completion."
  graph_memory:
    state: [[ graph_state ]]
    connection: ""
    authentication: none
    credential_reference: ""
    allowed_reads: []
    allowed_writes: []
    write_authorization_rule: ""
    dry_run_or_local_validation: ""
    unavailable_fallback: "Use repository files, checked plans, validation output, and Git history as the source of truth."
  browser_run:
    state: disabled
    connection: ""
    authentication: none
    credential_reference: ""
    allowed_reads: []
    allowed_writes: []
    write_authorization_rule: ""
    dry_run_or_local_validation: ""
    unavailable_fallback: "Use ordinary HTTP retrieval when sufficient; otherwise report that no authorized browser backend is available."
[% endif %]
