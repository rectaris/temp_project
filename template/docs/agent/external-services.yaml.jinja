[% set mcp_state = "documented" if mcp_policy_mode == "document_optional" else "disabled" %]
[% set linear_state = "documented" if linear_sync_mode == "document_optional" else "disabled" %]
[% set graph_state = "documented" if graph_memory_mode == "document_optional" else "disabled" %]
version: 1

states:
  disabled: Policy exists, but service reads and writes are not authorized.
  documented: Setup guidance exists, but service reads and writes are not authorized.
  configured_read_only: Connection, authentication, credential reference, and allowed reads pass the common external-service gate.
  configured_write_capable: Read requirements pass, allowed writes are non-empty, and the write-authorization check passes.

external_services:
  mcp:
    state: [[ mcp_state ]]
    connection: ""
    authentication: none
    credential_reference: ""
    allowed_reads: []
    allowed_writes: []
    write_authorization_rule: ""
    dry_run_or_local_validation: ""
    unavailable_fallback: "Use local repository files, plans, and validation only."
  linear_sync:
    state: [[ linear_state ]]
    connection: ""
    authentication: none
    credential_reference: ""
    allowed_reads: []
    allowed_writes: []
    write_authorization_rule: ""
    dry_run_or_local_validation: ""
    unavailable_fallback: "Keep plan lifecycle local and record sync deferral only when it affects scope or completion."
  graph_memory:
    state: [[ graph_state ]]
    connection: ""
    authentication: none
    credential_reference: ""
    allowed_reads: []
    allowed_writes: []
    write_authorization_rule: ""
    dry_run_or_local_validation: ""
    unavailable_fallback: "Use repository files, checked plans, validation output, and Git history as the source of truth."
  browser_run:
    state: disabled
    connection: ""
    authentication: none
    credential_reference: ""
    allowed_reads: []
    allowed_writes: []
    write_authorization_rule: ""
    dry_run_or_local_validation: ""
    unavailable_fallback: "Use ordinary HTTP retrieval when sufficient; otherwise report that no authorized browser backend is available."
