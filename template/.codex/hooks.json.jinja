{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.project-agent-workflow/hooks/agent_log_event.py\" --event SessionStart",
            "timeout": 30,
            "statusMessage": "Logging Codex session start"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.project-agent-workflow/hooks/semantic_guard_advisory.py\"",
            "timeout": 30,
            "statusMessage": "Restoring active referent contracts"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.project-agent-workflow/hooks/agent_log_event.py\" --event UserPromptSubmit",
            "timeout": 30,
            "statusMessage": "Logging user prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.project-agent-workflow/hooks/agent_log_event.py\" --event PreToolUse",
            "timeout": 30,
            "statusMessage": "Logging tool request"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.project-agent-workflow/hooks/pre_tool_hardening_gate.py\"",
            "timeout": 30,
            "statusMessage": "Checking tool safety"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.project-agent-workflow/hooks/agent_log_event.py\" --event PostToolUse",
            "timeout": 30,
            "statusMessage": "Logging tool result"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.project-agent-workflow/hooks/agent_log_event.py\" --event PreCompact",
            "timeout": 30,
            "statusMessage": "Logging pre-compact event"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.project-agent-workflow/hooks/agent_log_event.py\" --event PostCompact",
            "timeout": 30,
            "statusMessage": "Logging post-compact event"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.project-agent-workflow/hooks/semantic_guard_advisory.py\"",
            "timeout": 30,
            "statusMessage": "Restoring active referent contracts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.project-agent-workflow/hooks/agent_log_event.py\" --event Stop",
            "timeout": 30,
            "statusMessage": "Logging turn stop"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.project-agent-workflow/hooks/semantic_guard_advisory.py\"",
            "timeout": 30,
            "statusMessage": "Checking active referent contracts"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.project-agent-workflow/hooks/stop_review_gate.py\"",
            "timeout": 30,
            "statusMessage": "Checking completion lifecycle"
          }
        ]
      }
    ]
  }
}
